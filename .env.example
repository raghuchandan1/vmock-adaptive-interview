# Copy this file to .env and add your key. The key stays on your computer.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (you can also change models in Settings in the page)
# One model per prompt (defaults below; see docs/research/2026-11-14-playground-model-comparison/)
# PLANNER_MODEL=gpt-6-sol
# PLANNER_REASONING_EFFORT=medium
# TURN_MODEL=gpt-6-sol
# TURN_REASONING_EFFORT=low
# FEEDBACK_MODEL=gpt-6-sol
# FEEDBACK_REASONING_EFFORT=low
# GROUNDING_MODEL=gpt-6-sol          (the check on feedback's improved answers; follows FEEDBACK_MODEL when unset)
# GROUNDING_REASONING_EFFORT=low     (follows FEEDBACK_REASONING_EFFORT when unset)
# PORT=3000
# MARKET=india   (india or us: whose recruiting the interviews follow; us keeps domain-knowledge questions for finance and technical roles only)

# Voice on the student page (/student). Default: OpenAI voices. The project needs access to the audio models.
# OPENAI_API_TTS_STT_KEY=sk-...   (optional: a separate key for speech and transcription; else OPENAI_API_KEY)
# VOICE_PROVIDER=browser          (use the browser's own speech instead, Chrome or Edge)
# TTS_MODEL=gpt-4o-mini-tts-2025-12-15
# TTS_VOICE=cedar
#   (alternative that also sounds good: TTS_MODEL=tts-1-hd and TTS_VOICE=nova)
# STT_MODEL=gpt-transcribe   (falls back to gpt-4o-mini-transcribe)