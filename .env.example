# Copy this file to .env and add your key. The key stays on your computer.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (you can also change models in Settings in the page)
# PLANNER_MODEL=gpt-5
# PLANNER_REASONING_EFFORT=medium
# TURN_MODEL=gpt-5-mini
# TURN_REASONING_EFFORT=low
# PORT=3000

# Voice on the student page (/student). Default: the browser's own speech (Chrome or Edge), no audio models needed.
# VOICE_PROVIDER=openai uses OpenAI voices instead; the OpenAI project then needs access to these models.
# VOICE_PROVIDER=browser
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin
# STT_MODEL=gpt-transcribe   (falls back to gpt-4o-mini-transcribe)